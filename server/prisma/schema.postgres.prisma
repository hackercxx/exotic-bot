// EXOTIC BOT — Prisma schema (PROD: PostgreSQL)
// Prod Postgres variant: schema.postgres.prisma (identical models, different provider).
// Switch: DB_PROVIDER=postgres npm run db:generate   (see scripts/select-provider.mjs)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  // Password-reset flow (expires after 1 hour)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  accounts     Account[]
  posts        Post[]
  events       Event[]
  settings     Setting[]
  media        MediaAsset[]
  tracks       Track[]
}

model Account {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform         String // "INSTAGRAM" | "WHATSAPP"
  externalId       String // ig_user_id or phone_number_id
  label            String // display name (page name / business name)
  pageId           String?
  wabaId           String?
  phoneNumberId    String?
  accessToken      String // AES-256-GCM encrypted at rest
  tokenEncVersion  Int       @default(1)
  status           String    @default("CONNECTED") // CONNECTED | TOKEN_EXPIRING | DISCONNECTED
  tokenExpiresAt   DateTime?
  autoReplyEnabled Boolean   @default(false) // human-in-the-loop: OFF by default
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages      Message[]
  posts         Post[]
  metrics       Metric[]
  followerLists FollowerList[]
  unfollowers   Unfollower[]

  @@unique([userId, platform, externalId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform       String
  externalId     String? // Meta message id (mid / wamid)
  conversationKey String // stable sender key used to group a thread
  sender         String
  body           String
  direction      String // INBOUND | OUTBOUND
  aiGenerated    Boolean   @default(false)
  aiModel        String?
  latencyMs      Int?
  status         String @default("RECEIVED") // RECEIVED | REPLIED | BLOCKED | AWAITING_APPROVAL | AUTO_SENT | SENT | FAILED
  source         String? // MESSAGE | COMMENT (inbound origin)
  replyToExternalId String? // comment_id / message id to reply against
  replyToId      String?
  error          String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([accountId, createdAt])
  @@index([conversationKey, createdAt])
  @@index([status])
}

model Post {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String?
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  platform        String // INSTAGRAM | WHATSAPP
  caption         String
  captionVariantB String? // optional A/B variant
  mediaUrl        String?
  mediaType       String? // IMAGE | VIDEO | NONE
  target          String? // WhatsApp: recipient phone number (E.164)
  scheduledFor    DateTime?
  publishedAt     DateTime?
  status          String    @default("DRAFT") // DRAFT | SCHEDULED | PUBLISHING | PUBLISHED | FAILED
  externalId      String?
  error           String?
  attempts        Int       @default(0)
  cron            String? // recurring schedule, e.g. "0 18 * * 1,3,5"
  nextRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([userId, createdAt])

  insight PostInsight?
}

model PostInsight {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes      Int      @default(0)
  comments   Int      @default(0)
  shares     Int      @default(0)
  saves      Int      @default(0)
  reached    Int      @default(0)
  fetchedAt  DateTime @default(now())

  @@unique([postId])
}

model Event {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String // info | success | warn | error
  message   String
  meta      String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Metric {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date        DateTime
  followers   Int      @default(0)
  reach       Int      @default(0)
  impressions Int      @default(0)
  engagement  Int      @default(0)

  @@unique([accountId, date])
  @@index([accountId, date])
}

model Setting {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  encrypted Boolean @default(false) // value is AES-256-GCM encrypted when true

  @@unique([userId, key])
}

model MediaAsset {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename      String
  path          String
  mimeType      String
  sizeBytes     Int
  thumbnailPath String?
  width         Int?
  height        Int?
  durationMs    Int?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model Track {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  artist     String   @default("Unknown Artist")
  genre      String   @default("Uncategorized")
  coverPath  String?
  audioPath  String
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  platform       String
  objectId       String?
  payload        String // raw JSON
  signatureValid Boolean
  processed      Boolean  @default(false)
  error          String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model Job {
  id        String   @id @default(cuid())
  name      String // process:webhook | publish:post | refresh:token | sync:insights | ...
  payload   String   @default("{}")
  runAt     DateTime
  status    String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())

  @@index([status, runAt])
  @@index([name])
}

model FollowerList {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime
  ids       String // JSON array of follower external ids

  @@unique([accountId, date])
}

model Unfollower {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId String
  displayName String?
  detectedAt DateTime @default(now())

  @@index([accountId, detectedAt])
}
