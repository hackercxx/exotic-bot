# ── Browser product analytics (PostHog) ────────────────────────────────
# Vite reads env files from the web root, so copy this to web/.env
# (web/.env is git-ignored). Empty values keep capture off entirely.

# Public project token from PostHog → Project settings → Project API key.
# This is a *public* project token, never a personal API key.
VITE_POSTHOG_PROJECT_TOKEN=

# Ingestion host — US https://us.i.posthog.com, EU https://eu.i.posthog.com,
# or your own self-hosted ingestion domain (https only).
VITE_POSTHOG_HOST=
