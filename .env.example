# ── EXOTIC BOT environment ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# ── Core ───────────────────────────────────────────────────────────────
PORT=4000
PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3001
NODE_ENV=development

# Landing-screen "Create account" option. Default: open (set to false to
# restrict sign-ups to the very first run, recommended once public).
ALLOW_REGISTRATION=true

# SQLite (dev, default) → PostgreSQL (prod). See server/prisma/README.md
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://exotic:exotic@db:5432/exoticbot"

# ── Secrets ────────────────────────────────────────────────────────────
# 32-byte key, base64. Generate: openssl rand -base64 32
JWT_SECRET=change-me-jwt-secret-min-32-chars-long-please
ENCRYPTION_KEY=change-me-32-byte-base64-key-generate-one

# ── Meta / official APIs only ──────────────────────────────────────────
# Meta app credentials (developers.facebook.com) for Instagram OAuth
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/accounts/instagram/callback
# Webhook verification (GET /webhooks/meta)
VERIFY_TOKEN=change-me-verify-token
# Used to validate X-Hub-Signature-256 on inbound webhook POSTs
APP_SECRET=
# Public URL Meta can reach for webhooks (use an https tunnel in dev)
PUBLIC_WEBHOOK_URL=

# ── Instagram private API (username/password sign-in) ──────────────────
# Instagram blocks password logins from cloud/datacenter IPs. Point them at
# a residential proxy so the login comes from a home IP instead:
#   INSTAGRAM_PROXY_URL=http://user:pass@ip:port   (or ip:port:user:pass)
# Leave empty to connect directly. A per-account proxy pasted in the connect
# card's "Advanced settings" overrides this value.
INSTAGRAM_PROXY_URL=

# ── Queue ──────────────────────────────────────────────────────────────
# memory (default, DB-backed jobs — no Redis needed) | bullmq (needs Redis)
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# ── Browser product analytics (optional) ───────────────────────────────
# The Vite app reads VITE_POSTHOG_PROJECT_TOKEN / VITE_POSTHOG_HOST from
# web/.env — see web/.env.example. Empty = analytics capture stays off.

# ── AI (provider + key are set in Settings UI and encrypted at rest) ──
# Ollama is used when Settings → AI provider = ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
